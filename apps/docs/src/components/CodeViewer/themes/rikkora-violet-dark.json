  "semanticTokenColors": {
    "keyword": "#A56CFF",
    "variable": "#E6E6F1",
    "parameter": "#D9DCF5",
    "property": "#F4B860",
    "function": "#4FA3FF",
    "method": "#4FA3FF",
    "function.declaration": "#4FA3FF",
    "method.declaration": "#4FA3FF",
    "class": "#37CFC9",
    "interface": "#37CFC9",
    "type": "#37CFC9",
    "typeParameter": "#37CFC9",
    "namespace": "#C9A6FF",
    "enum": "#37CFC9",
    "enumMember": "#FF8A3D",
    "number": "#FF8A3D",
    "string": "#49C97E",
    "comment": "#7E84A8",
    "operator": "#C9CCDF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7E84A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#A56CFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4FA3FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#37CFC9"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D9DCF5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#F4B860"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E6E6F1"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#49C97E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "settings": {
        "foreground": "#FF8A3D"
      }
    },
    {
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#FF6F61"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#C9A6FF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C9CCDF"
      }
    },
    {
      "scope": [
        "punctuation.section.braces",
        "punctuation.section.brackets",
        "punctuation.section.parens",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A56CFF"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#A56CFF",
        "fontStyle": ""
      }
    }
  ]
}
