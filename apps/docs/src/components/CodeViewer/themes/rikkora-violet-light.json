    "editor.findMatchBackground": "#5B5FD333",
    "editor.findMatchBorder": "#5B5FD3",
    "editorIndentGuide.background1": "#E3E5F4",
    "editorIndentGuide.activeBackground1": "#C3C8EA",
    "editorWhitespace.foreground": "#D7DAEE",
