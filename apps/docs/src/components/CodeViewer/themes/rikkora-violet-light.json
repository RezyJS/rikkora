    "activityBarBadge.background": "#5B5FD3",
    "activityBarBadge.foreground": "#FFFFFF",
    "activityBar.border": "#E2E5F5",
    "titleBar.activeBackground": "#F4F5FE",
    "titleBar.activeForeground": "#2A2B3F",
    "titleBar.inactiveBackground": "#F4F5FE",
    "titleBar.inactiveForeground": "#8D92B5",
    "titleBar.border": "#E2E5F5",
    "statusBar.background": "#F4F5FE",
    "statusBar.foreground": "#3B3F61",
    "statusBar.border": "#E2E5F5",
    "statusBar.debuggingBackground": "#5B5FD3",
    "statusBar.debuggingForeground": "#FFFFFF",
    "panel.background": "#F4F5FE",
    "panel.border": "#E2E5F5",
    "panelTitle.activeForeground": "#2A2B3F",
