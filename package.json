{
  "name": "rikkora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ui,docs \"pnpm --filter @rikkora/ui dev\" \"pnpm --filter ./apps/docs dev\"",
    "build": "pnpm --filter @rikkora/ui build && pnpm --filter ./apps/docs build",
    "typecheck": "pnpm --filter @rikkora/ui typecheck && pnpm --filter ./apps/docs exec tsc -b",
    "check:ui": "pnpm --filter @rikkora/ui typecheck && pnpm --filter @rikkora/ui build",
    "test": "pnpm --filter @rikkora/ui build && playwright test",
    "test:ui": "pnpm test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6"
  }
}
